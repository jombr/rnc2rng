<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <element>
      <name ns="">root</name>
      <attribute>
        <name ns="">Algorithm</name>
        <data type="anyURI">
          <except>
            <ref name="excluded"/>
          </except>
        </data>
      </attribute>
    </element>
  </start>
  <define name="excluded">
    <value>urn:reserved</value>
  </define>
</grammar>
